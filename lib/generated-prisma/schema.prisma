generator client {
  provider = "prisma-client-js"
  output   = "./"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                        String                    @id @default(cuid())
  tenantId                  String?
  name                      String?
  email                     String?                   @unique
  emailVerified             DateTime?
  image                     String?
  hashedPassword            String?
  roleId                    String?
  employeeId                String?                   @unique
  phone                     String?
  department                String?
  specialization            String?
  tenant                    Tenant?                   @relation(fields: [tenantId], references: [id])
  isActive                  Boolean                   @default(true)
  createdAt                 DateTime                  @default(now())
  updatedAt                 DateTime                  @updatedAt
  accounts                  Account[]
  closedPeriods             AccountingPeriod[]
  admissions                Admission[]               @relation("AdmittingDoctor")
  admissionsCancelled       Admission[]               @relation("AdmissionCanceller")
  ipdRequestsRequested      IpdRequest[]              @relation("IpdRequestRequester")
  ipdRequestsReviewed       IpdRequest[]              @relation("IpdRequestReviewer")
  appointments              Appointment[]
  createdBudgets            Budget[]                  @relation("CreatedBudgets")
  finalizedDailySummaries   DailyChargeSummary[]      @relation("SummaryFinalizer")
  appliedDeposits           DepositApplication[]      @relation("DepositApplier")
  dispensingLogs            DispensingLog[]           @relation("UserDispensingLogs")
  recordedExpenses          Expense[]                 @relation("RecordedExpenses")
  closedFiscalYears         FiscalYear[]
  usedFloorStocks           FloorStockUsage[]         @relation("FloorStockUser")
  goodsReceipts             GoodsReceipt[]            @relation("GoodsReceiver")
  createdInpatientCharges   InpatientCharge[]         @relation("ChargeCreator")
  nursedCharges             InpatientCharge[]         @relation("NurseCharge")
  receivedDeposits          InpatientDeposit[]        @relation("DepositReceiver")
  issuedInvoices            Invoice[]                 @relation("IssuedInvoices")
  approvedJournals          JournalEntry[]            @relation("ApprovedJournals")
  createdJournals           JournalEntry[]            @relation("CreatedJournals")
  labOrders                 LabOrder[]
  receivedPayments          Payment[]                 @relation("ReceivedPayments")
  prescriptions             Prescription[]
  radiologyOrders           RadiologyOrder[]
  purchaseApprovals         PurchaseOrder[]           @relation("POApprover")
  purchaseRequests          PurchaseOrder[]           @relation("PORequestor")
  sessions                  Session[]
  stockAdjustApps           StockAdjustment[]         @relation("AdjustmentApprover")
  stockAdjustReqs           StockAdjustment[]         @relation("AdjustmentRequestor")
  stockMovements            StockMovement[]
  stockTakesCounted         StockTake[]               @relation("Counter")
  stockTakesVerified        StockTake[]               @relation("Verifier")
  createdTaxInvoices        TaxInvoice[]              @relation("CreatedTaxInvoices")
  role                      Role?                     @relation(fields: [roleId], references: [id])
  visits                    Visit[]
  accountsClearedVisits     Visit[]                   @relation("VisitAccountsCleared")
  discontinuedVisits        Visit[]                   @relation("VisitDiscontinuation")
  priceChanges              DrugPriceAudit[]          @relation("PriceChanges")
  uploadedImages            DrugImage[]               @relation("UploadedImages")
  createdLabTemplates       LabResultTemplate[]       @relation("LabTemplateCreator")
  updatedLabTemplates       LabResultTemplate[]       @relation("LabTemplateUpdater")
  createdRadiologyTemplates RadiologyResultTemplate[] @relation("RadiologyTemplateCreator")
  updatedRadiologyTemplates RadiologyResultTemplate[] @relation("RadiologyTemplateUpdater")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Role {
  id          String       @id @default(cuid())
  name        String       @unique
  description String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  users       User[]
  permissions Permission[] @relation("PermissionToRole")
}

model Permission {
  id          String   @id @default(cuid())
  action      String
  description String?
  createdAt   DateTime @default(now())
  roles       Role[]   @relation("PermissionToRole")
}

model Patient {
  id                    String           @id @default(cuid())
  patientNumber         String           @unique
  firstName             String
  lastName              String
  dateOfBirth           DateTime
  gender                String
  bloodGroup            String?
  maritalStatus         String?
  occupation            String?
  phone                 String
  alternativePhone      String?
  email                 String?
  address               String?
  city                  String?
  district              String?
  emergencyContactName  String?
  emergencyContactPhone String?
  emergencyContactRel   String?
  nextOfKinName         String?
  nextOfKinPhone        String?
  nextOfKinEmail        String?
  nextOfKinAddress      String?
  nextOfKinRel          String?
  allergies             String?
  chronicConditions     String?
  currentMedications    String?
  isActive              Boolean          @default(true)
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  admissions            Admission[]
  appointments          Appointment[]
  diagnoses             Diagnosis[]
  dispensingLogs        DispensingLog[]
  invoices              Invoice[]
  labOrders             LabOrder[]
  notifications         Notification[]
  radiologyOrders       RadiologyOrder[]
  prescriptions         Prescription[]
  taxInvoices           TaxInvoice[]
  visits                Visit[]
}

model Visit {
  id               String    @id @default(cuid())
  visitNumber      String    @unique
  patientId        String
  type             VisitType @default(OPD)
  chiefComplaint   String?
  bloodPressure    String?
  heartRate        String?
  temperature      String?
  weight           Float?
  height           Float?
  priority         String    @default("Normal")
  status           String    @default("Waiting")
  subjective       String?
  objective        String?
  assessment       String?
  treatmentPlan    String?
  assignedDoctorId String?
  checkInTime      DateTime  @default(now())
  completedTime    DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // Payment Clearance Workflow
  consultationFeePaid   Boolean   @default(false)
  consultationFeeAmount Float?
  consultationFeePaidAt DateTime?
  consultationInvoiceId String?
  labFeesPaid           Boolean   @default(false)
  labFeesAmount         Float?
  labFeesPaidAt         DateTime?
  labInvoiceId          String?
  accountsCleared       Boolean   @default(false)
  accountsClearedAt     DateTime?
  accountsClearedById   String?

  // Discontinuation (admin-only, terminal, requires note)
  discontinuationNote String?
  discontinuationDate DateTime?
  discontinuationById String?

  // Follow-up linkage to a prior visit (within 14 days, must be Completed)
  linkedPriorVisitId String?

  // Relations
  admission           Admission?
  ipdRequests         IpdRequest[]
  diagnoses           Diagnosis[]
  dispensingLogs      DispensingLog[]
  invoices            Invoice[]
  labOrders           LabOrder[]
  prescriptions       Prescription[]
  radiologyOrders     RadiologyOrder[]
  orderWriteOffs      OrderWriteOff[]
  followUpVisits      Visit[]          @relation("VisitFollowUp")
  doctor              User?            @relation(fields: [assignedDoctorId], references: [id])
  patient             Patient          @relation(fields: [patientId], references: [id])
  consultationInvoice Invoice?         @relation("VisitConsultationInvoice", fields: [consultationInvoiceId], references: [id])
  labInvoice          Invoice?         @relation("VisitLabInvoice", fields: [labInvoiceId], references: [id])
  accountsClearedBy   User?            @relation("VisitAccountsCleared", fields: [accountsClearedById], references: [id])
  discontinuationBy   User?            @relation("VisitDiscontinuation", fields: [discontinuationById], references: [id])
  linkedPriorVisit    Visit?           @relation("VisitFollowUp", fields: [linkedPriorVisitId], references: [id])

  @@index([patientId])
  @@index([assignedDoctorId])
  @@index([status])
  @@index([consultationFeePaid])
  @@index([labFeesPaid])
  @@index([accountsCleared])
}

model Appointment {
  id            String   @id @default(cuid())
  patientId     String
  doctorId      String
  date          DateTime
  duration      Int
  reason        String
  status        String   @default("Pending")
  notesForStaff String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  doctor        User     @relation(fields: [doctorId], references: [id])
  patient       Patient  @relation(fields: [patientId], references: [id])

  @@index([patientId])
  @@index([doctorId])
  @@index([date])
}

model Diagnosis {
  id         String   @id @default(cuid())
  visitId    String
  patientId  String
  code       String?
  name       String
  category   String?
  notes      String?
  icdVersion String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  patient    Patient  @relation(fields: [patientId], references: [id])
  visit      Visit    @relation(fields: [visitId], references: [id], onDelete: Cascade)

  @@index([visitId])
  @@index([patientId])
}

model ICD11Code {
  id    String @id @default(cuid())
  code  String @unique
  title String
}

model ICD10Code {
  id    String @id @default(cuid())
  code  String @unique
  title String
}

// ─── Consultation fee categories (multi-tier pricing) ────────────────
// One row per fee tier per tenant. Examples: "Standard OPD", "Senior
// Specialist", "Pediatric", "Telemedicine", "Follow-up (waived)".
// A visit is charged the fee from the category whose `visitTypes` CSV
// includes the visit's type. Multiple categories can target the same
// visit type — the caller picks which one to apply (or `isDefault`
// picks the fallback).
model ConsultationFeeCategory {
  id          String   @id @default(cuid())
  tenantId    String?
  name        String
  fee         Float
  visitTypes  String   // CSV of VisitType values, e.g. "OPD,OTHER"
  description String?
  isActive    Boolean  @default(true)
  isDefault   Boolean  @default(false)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tenant      Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, isActive])
  @@index([tenantId, isDefault])
}

model Prescription {
  id             String   @id @default(cuid())
  visitId        String
  patientId      String
  doctorId       String
  medicationName String
  dosage         String
  frequency      String
  durationDays   Int
  quantity       Int
  instructions   String?
  refills        Int      @default(0)
  status         String   @default("Pending")
  // Consolidated visit cycle: per-order sub-status (AwaitingPayment | InProgress | Fulfilled | Unfulfilled)
  subStatus      String   @default("AwaitingPayment")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  drugId         String?

  // Structured dose fields for auto-quantity calculation
  // doseAmount × frequencyPerDay × durationDays = quantity (auto)
  doseAmount       Float?
  doseUnit         String?
  frequencyPerDay  Int?
  isManualQuantity Boolean @default(false) // true = doctor overrode auto-calc

  dispensingLogs DispensingLog[]
  doctor         User            @relation(fields: [doctorId], references: [id])
  patient        Patient         @relation(fields: [patientId], references: [id])
  visit          Visit           @relation(fields: [visitId], references: [id], onDelete: Cascade)
  drug           Drug?           @relation(fields: [drugId], references: [id])

  // Pharmacy Payment Clearance
  pharmacyFeesPaid   Boolean   @default(false)
  pharmacyFeesAmount Float?
  pharmacyFeesPaidAt DateTime?
  pharmacyInvoiceId  String?
  pharmacyInvoice    Invoice?  @relation("PrescriptionPharmacyInvoice", fields: [pharmacyInvoiceId], references: [id])

  @@index([visitId])
  @@index([patientId])
  @@index([doctorId])
  @@index([pharmacyFeesPaid])
}

model LabOrder {
  id                  String   @id @default(cuid())
  visitId             String
  patientId           String
  doctorId            String
  testName            String
  testCategory        String
  priority            String   @default("Routine")
  specialInstructions String?
  status              String   @default("Ordered")
  // Consolidated visit cycle: per-order sub-status (AwaitingPayment | InProgress | Fulfilled | Unfulfilled)
  subStatus           String   @default("AwaitingPayment")
  result              String?
  resultFlags         String?
  resultRows          String? // JSON-stringified array of investigation rows (for table-mode reports)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  doctor              User     @relation(fields: [doctorId], references: [id])
  patient             Patient  @relation(fields: [patientId], references: [id])
  visit               Visit    @relation(fields: [visitId], references: [id], onDelete: Cascade)

  // Payment Clearance
  feesPaid   Boolean   @default(false)
  feesAmount Float?
  feesPaidAt DateTime?
  invoiceId  String?
  invoice    Invoice?  @relation("LabOrderInvoice", fields: [invoiceId], references: [id])

  @@index([visitId])
  @@index([patientId])
  @@index([doctorId])
  @@index([feesPaid])
}

model RadiologyCategory {
  id          String             @id @default(cuid())
  name        String             @unique
  description String?
  isActive    Boolean            @default(true)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  exams       RadiologyCatalog[]
}

model RadiologyCatalog {
  id                      String                   @id @default(cuid())
  name                    String                   @unique
  categoryId              String
  category                RadiologyCategory        @relation(fields: [categoryId], references: [id])
  description             String?
  price                   Float                    @default(0.0)
  referenceRange          String?
  preparationInstructions String?
  turnaroundTime          String? // e.g. "2 hours", "24 hours"
  isActive                Boolean                  @default(true)
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  resultTemplate          RadiologyResultTemplate?
}

model RadiologyResultTemplate {
  id                 String           @id @default(cuid())
  radiologyCatalogId String           @unique
  templateName       String           @default("Standard Report")
  headerHtml         String?
  templateHtml       String
  footerHtml         String?
  isActive           Boolean          @default(true)
  createdById        String?
  updatedById        String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  radiologyCatalog   RadiologyCatalog @relation(fields: [radiologyCatalogId], references: [id], onDelete: Cascade)
  createdBy          User?            @relation("RadiologyTemplateCreator", fields: [createdById], references: [id])
  updatedBy          User?            @relation("RadiologyTemplateUpdater", fields: [updatedById], references: [id])
}

model RadiologyOrder {
  id            String    @id @default(cuid())
  visitId       String
  patientId     String
  doctorId      String
  examName      String
  category      String
  priority      String    @default("Routine")
  clinicalNotes String?
  status        String    @default("Ordered") // Ordered, InProgress, Completed, Cancelled
  // Consolidated visit cycle: per-order sub-status (AwaitingPayment | InProgress | Fulfilled | Unfulfilled)
  subStatus     String    @default("AwaitingPayment")
  result        String?
  reportUrl     String?
  completedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // GMC Victoria Hospital structured report fields
  modality         String? // e.g. "X-Ray", "CT", "MRI", "Ultrasound"
  technique        String? // How the study was performed
  findings         String? // Detailed observations
  impression       String? // Radiologist's conclusion
  recommendations  String? // Follow-up suggestions
  radiologistNotes String? // Internal notes (not printed)
  contrastUsed     Boolean @default(false) // Contrast agent administered?

  doctor  User    @relation(fields: [doctorId], references: [id])
  patient Patient @relation(fields: [patientId], references: [id])
  visit   Visit   @relation(fields: [visitId], references: [id], onDelete: Cascade)

  // Billing
  feesPaid   Boolean   @default(false)
  feesAmount Float?
  feesPaidAt DateTime?
  invoiceId  String?
  invoice    Invoice?  @relation("RadiologyOrderInvoice", fields: [invoiceId], references: [id])

  @@index([visitId])
  @@index([patientId])
  @@index([doctorId])
  @@index([status])
}

// Audit log for orders that were auto-cancelled by the 90-minute write-off cron.
// Per the consolidated visit cycle spec, AwaitingPayment orders that stay unpaid
// past 90 min get transitioned to Unfulfilled and their invoice line is destroyed.
// This model records the cancellation for traceability.
model OrderWriteOff {
  id           String   @id @default(cuid())
  visitId      String
  // "LAB" | "RADIOLOGY" | "PRESCRIPTION" — discriminator for the cancelled item
  itemType     String
  // ID of the cancelled LabOrder / RadiologyOrder / Prescription row
  itemId       String
  // ID of the Invoice that had the line destroyed (nullable if no invoice was ever created)
  invoiceId    String?
  writtenOffAt DateTime @default(now())
  // The original scheduledAt / createdAt of the order (preserved for forensic "how late was it")
  scheduledAt  DateTime
  // Free-text reason — typically "90-minute write-off" or admin-supplied note
  reason       String
  createdAt    DateTime @default(now())

  visit Visit @relation(fields: [visitId], references: [id], onDelete: Cascade)

  @@index([visitId])
  @@index([itemType, itemId])
  @@index([writtenOffAt])
}

model DrugCategory {
  id          String         @id @default(cuid())
  name        String         @unique
  code        String         @unique
  description String?
  parentId    String?
  isActive    Boolean        @default(true)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  drugs       Drug[]
  parent      DrugCategory?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children    DrugCategory[] @relation("CategoryHierarchy")
}

model Drug {
  id                String           @id @default(cuid())
  drugCode          String           @unique
  name              String
  genericName       String
  categoryId        String
  drugClass         String?
  schedule          DrugSchedule
  isControlled      Boolean          @default(false)
  dosageForm        DosageForm
  strength          String
  strengthValue     Float            @default(0)
  strengthUnit      String?
  packageSize       Int
  packageUnit       String
  manufacturer      String?
  countryOfOrigin   String?
  indications       String?
  contraindications String?
  sideEffects       String?
  storage           StorageCondition
  shelfLifeMonths   Int?
  isActive          Boolean          @default(true)
  isRestricted      Boolean          @default(false)

  // ===== Industry Standard Drug Identifiers =====
  gtin               String? @unique // GS1 Global Trade Item Number
  atcCode            String? // WHO Anatomical Therapeutic Chemical classification (e.g., J01CA04)
  rxNormCui          String? // RxNorm Concept Unique Identifier
  unii               String? // FDA Unique Ingredient Identifier
  barcode            String? @unique // Code128/EAN-13 for point-of-dispense scanning
  registrationNumber String? // NDA/MA approval number
  ndcCode            String? // US National Drug Code

  // ===== Clinical =====
  route              RouteOfAdministration? // oral/IV/IM/topical/etc.
  pregnancyCategory  PregnancyCategory?     @default(UNKNOWN)
  hasBlackBoxWarning Boolean                @default(false)
  mechanismOfAction  String?
  halfLifeHours      Float? // pharmacokinetics
  therapeuticClass   String? // e.g., "Beta-lactam antibiotic", "NSAID"
  localName          String? // Local-language name for the market

  // ===== Formulary =====
  formularyStatus            FormularyStatus @default(FORMULARY)
  requiresPriorAuth          Boolean         @default(false)
  genericSubstitutionAllowed Boolean         @default(true)
  isBrand                    Boolean         @default(false) // true = brand, false = generic

  // ===== Pill Identifier (visual verification) =====
  pillShape   PillShape?
  pillColor   PillColor?
  pillImprint String? // e.g., "M 500"
  imageUrl    String? // primary drug image

  // ===== Packaging =====
  packType              PackType?
  unitsPerPack          Int? // e.g., 100 tablets per box
  minimumDispensingUnit Float?    @default(1) // minimum units that can be dispensed
  isUnitDose            Boolean   @default(false) // single-dose packaging (e.g., ampoule, vial)

  // ===== Inventory Operations =====
  reorderLevel        Int? // when stock ≤ this, trigger reorder
  maxStock            Int? // ceiling for ordering
  leadTimeDays        Int? // expected days from PO to delivery
  averageMonthlyUsage Float? // 90-day rolling average units/month
  standardUnitCost    Float? // weighted average cost
  lastPurchaseDate    DateTime?
  preferredSupplierId String?
  preferredSupplier   Supplier? @relation("PreferredSupplier", fields: [preferredSupplierId], references: [id])

  // ===== Costing =====
  costPrice     Float? // wholesale cost reference
  markupPercent Float? // default markup applied to cost

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ===== Relations =====
  dispensingLogs    DispensingLog[]
  category          DrugCategory          @relation(fields: [categoryId], references: [id])
  batches           DrugBatch[]
  priceList         DrugPrice[]
  priceAudits       DrugPriceAudit[]
  floorStocks       FloorStock[]
  goodsReceiptItems GoodsReceiptItem[]
  purchaseOrders    PurchaseOrderItem[]
  stockMovements    StockMovement[]
  prescriptions     Prescription[]
  images            DrugImage[]
  interactions      DrugInteraction[]     @relation("DrugFrom")
  interactedBy      DrugInteraction[]     @relation("DrugTo")
  dosageGuidelines  DrugDosageGuideline[]
}

model DrugBatch {
  id                String             @id @default(cuid())
  drugId            String
  batchNumber       String
  supplierId        String?
  manufacturingDate DateTime?
  expiryDate        DateTime
  receivedDate      DateTime           @default(now())
  quantityReceived  Int
  quantityRemaining Int
  quantityReserved  Int                @default(0)
  quantityDamaged   Int                @default(0)
  quantityExpired   Int                @default(0)
  purchasePrice     Float
  sellingPrice      Float?
  wholesalePrice    Float?
  taxRate           Float?             @default(0)
  storageLocation   String?
  qualityCheckDate  DateTime?
  qualityCheckBy    String?
  qualityCheckPass  Boolean?           @default(true)
  isSplittable      Boolean            @default(false) // true = tablet can be split (e.g., scored); false = must dispense whole units
  isActive          Boolean            @default(true)
  notes             String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  dispensingLogs    DispensingLog[]
  drug              Drug               @relation(fields: [drugId], references: [id])
  supplier          Supplier?          @relation(fields: [supplierId], references: [id])
  goodsReceiptItems GoodsReceiptItem[]
  stockMovements    StockMovement[]
}

model DrugPrice {
  id             String            @id @default(cuid())
  drugId         String
  priceType      PharmacyPriceType
  price          Float
  currency       String            @default("UGX")
  effectiveFrom  DateTime
  effectiveTo    DateTime?
  minQuantity    Int?              @default(1)
  maxQuantity    Int?
  isTaxInclusive Boolean           @default(false)
  taxRate        Float?            @default(0)
  isActive       Boolean           @default(true)
  createdById    String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  drug           Drug              @relation(fields: [drugId], references: [id])

  @@unique([drugId, priceType, effectiveFrom])
  @@index([drugId])
  @@index([isActive])
}

model DrugPriceAudit {
  id          String            @id @default(cuid())
  drugId      String
  priceType   PharmacyPriceType
  oldPrice    Float
  newPrice    Float
  currency    String            @default("UGX")
  changedById String?
  changedAt   DateTime          @default(now())
  reason      String?
  drug        Drug              @relation(fields: [drugId], references: [id])
  changedBy   User?             @relation("PriceChanges", fields: [changedById], references: [id])

  @@index([drugId])
  @@index([changedAt])
}

model DrugInteraction {
  id                  String              @id @default(cuid())
  drugId              String
  interactsWithDrugId String
  severity            InteractionSeverity
  description         String?
  clinicalEffect      String?
  managementAdvice    String?
  evidenceLevel       String? // e.g., "Established", "Theoretical"
  isActive            Boolean             @default(true)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  drug                Drug                @relation("DrugFrom", fields: [drugId], references: [id], onDelete: Cascade)
  interactingDrug     Drug                @relation("DrugTo", fields: [interactsWithDrugId], references: [id], onDelete: Cascade)

  @@unique([drugId, interactsWithDrugId])
  @@index([drugId])
  @@index([interactsWithDrugId])
  @@index([severity])
}

model DrugDosageGuideline {
  id            String                 @id @default(cuid())
  drugId        String
  indication    String
  ageGroup      String // "Adult", "Pediatric", "Geriatric", "Neonatal"
  ageMin        Int? // in years
  ageMax        Int?
  minDose       Float
  maxDose       Float
  doseUnit      String // mg, ml, tablet, puff, drop
  frequency     String // e.g., "Once daily", "BID", "QID", "PRN"
  route         RouteOfAdministration?
  durationDays  Int? // null = PRN / chronic
  renalAdjust   String? // e.g., "CrCl <30: halve dose"
  hepaticAdjust String?
  icd10Code     String?
  notes         String?
  source        String? // BNF, FDA label, WHO, etc.
