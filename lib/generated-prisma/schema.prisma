// ============================================================================
// IpdRequest (R62)
//
// A doctor's request to admit a visit to IPD. Splits the medical decision
// (doctor submits) from the operational transition (admin/reception fulfils).
// The visit is NOT changed to INPATIENT until an admin/reception user
// fulfils the request — the visit stays in its OPD status throughout.
//
// Status state machine:
//   PENDING  -> APPROVED   -> FULFILLED
//   PENDING  -> REJECTED   (terminal)
//   PENDING  -> CANCELLED  (doctor changes mind; terminal)
//
// On FULFILLED, the request links to the resulting Admission (one-to-one).
// The Visit.type and Visit.status are also updated in the same transaction.
//
// Allowed roles per action:
//   POST   /api/ipd-requests          DOCTOR (own visit), ADMIN, SUPER_ADMIN
//   POST   /api/ipd-requests/[id]/cancel    DOCTOR (own request, PENDING only)
//   POST   /api/ipd-requests/[id]/approve  ADMIN, RECEPTIONIST, SUPER_ADMIN
//   POST   /api/ipd-requests/[id]/reject   ADMIN, RECEPTIONIST, SUPER_ADMIN
//   POST   /api/ipd-requests/[id]/fulfill  ADMIN, RECEPTIONIST, SUPER_ADMIN
// ============================================================================
model IpdRequest {
  id                 String    @id @default(cuid())
  requestNumber      String    @unique // IPDREQ-YYYYMMDD-NNN
  visitId            String
  requestedById      String // doctor who submitted
  reasonForAdmission String
  admittingDiagnosis String? // free text — ICD code/name if available
  urgency            String // EMERGENCY | URGENT | ELECTIVE
  preferredWardId    String?
  preferredBedType   String? // STANDARD | DELUXE | PRIVATE
  clinicalNotes      String?
  status             String    @default("PENDING")
  // PENDING | APPROVED | REJECTED | CANCELLED | FULFILLED
  reviewedById       String?
  reviewedAt         DateTime?
  reviewNotes        String?
  fulfilledAt        DateTime?
  admissionId        String?   @unique
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  visit         Visit      @relation(fields: [visitId], references: [id], onDelete: Cascade)
  requestedBy   User       @relation("IpdRequestRequester", fields: [requestedById], references: [id])
  reviewedBy    User?      @relation("IpdRequestReviewer", fields: [reviewedById], references: [id])
  preferredWard Ward?      @relation(fields: [preferredWardId], references: [id])
  admission     Admission? @relation("IpdRequestAdmission", fields: [admissionId], references: [id])

  @@index([visitId])
  @@index([status])
  @@index([requestedById])
  @@index([urgency, status])
}

