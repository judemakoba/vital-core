  journalEntry   JournalEntry   @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
}

model TaxInvoice {
  id                 String              @id @default(cuid())
  invoiceNumber      String              @unique
  invoiceType        InvoiceType
  patientId          String?
  customerName       String?
  customerTin        String?
  customerAddress    String?
  customerEmail      String?
  invoiceDate        DateTime
  dueDate            DateTime?
  postingDate        DateTime
  subtotal           Float
  discountTotal      Float               @default(0)
  taxTotal           Float               @default(0)
  totalAmount        Float
  taxBreakdown       Json?
  amountPaid         Float               @default(0)
  balanceDue         Float
  paymentStatus      PaymentStatus       @default(PENDING)
  originalInvoiceId  String?
  // Link to the parent legacy Invoice when this TaxInvoice is a sub-bill for the
  // pharmacy portion of a visit. Summary endpoints use this to avoid double-counting.
  parentInvoiceId    String?
  parentInvoice      Invoice?            @relation("TaxInvoiceParent", fields: [parentInvoiceId], references: [id])
  creditReason       String?
  isRecurring        Boolean             @default(false)
  recurringFrequency RecurringFrequency?
  recurringEndDate   DateTime?
  qrCode             String?
  digitalSignature   String?
  taxRateId          String?
  journalEntryId     String?
  createdById        String
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  printedCount       Int                 @default(0)
  lastPrintedAt      DateTime?
  lines              InvoiceLine[]
  payments           Payment[]
  allocations        PaymentAllocation[]
