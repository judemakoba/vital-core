// =============================================================================
// Tenant Configuration
// =============================================================================
//
// VitalCore is deployed as one DB instance per hospital/clinic. The Tenant
// model holds the *identity* of that instance (name, address, branding, etc.)
// and is a singleton (single row).
//
// TenantSetting is a typed key-value store that replaces the old
// SystemSetting model. Every configurable behavior in the app is registered
// here with type, default, and category metadata. See lib/settings/registry.ts.
//
// Branch supports multi-location hospitals (main campus + satellite clinics).
// User.tenantId is reserved for future SaaS use; current single-tenant
// installs leave it null.
// =============================================================================

model Tenant {
  id                         String    @id @default(cuid())
  name                       String
  shortName                  String? // short display name, e.g. "GMC" vs "Victoria Hospital"
  code                       String    @unique // internal short code, e.g. "GMC-VIC"
  address                    String?
  city                       String?
  region                     String?
  country                    String?   @default("UG")
  phone                      String?
  email                      String?
  website                    String?
  taxId                      String? // TIN / KRA PIN / etc.
  registrationNumber         String? // Hospital/clinic registration / license #
  licenseExpiry              DateTime?
  logoUrl                    String?
  faviconUrl                 String?
  // Brand
  primaryColor               String?   @default("#6366f1")
  accentColor                String?   @default("#10b981")
  reportFont                 String?   @default("Times New Roman")
  // Locale
  timezone                   String?   @default("Africa/Kampala")
  dateFormat                 String?   @default("DD/MM/YYYY") // DD/MM/YYYY | MM/DD/YYYY | YYYY-MM-DD
  timeFormat                 String?   @default("24h") // 12h | 24h
  locale                     String?   @default("en-GB") // BCP-47 tag
  firstDayOfWeek             Int       @default(1) // 0=Sun, 1=Mon, ..., 6=Sat
  // Money
  currency                   String?   @default("UGX")
  currencyPosition           String?   @default("prefix") // prefix | suffix
  decimalPlaces              Int       @default(0)
  // Finance
  fiscalYearStartMonth       Int       @default(7) // 1=Jan ... 12=Dec
  cogsAccountCode            String?   @default("5110")
  defaultTaxRate             Float?    @default(0) // 18 = 18%
  // Numbering
  // Format strings use {TOKEN} placeholders; see lib/formatters.ts renderNumber().
  // Tokens: {PREFIX} {YYYY} {YY} {MM} {DD} {HH} {MI} {SEQ} {SEQ:n} (n = pad width)
  patientNumberPrefix        String?   @default("PAT")
  patientNumberFormat        String?   @default("{PREFIX}-{YYYY}{MM}{DD}-{SEQ:4}")
  visitNumberPrefix          String?   @default("VST")
  visitNumberFormat          String?   @default("{PREFIX}-{YYYY}{MM}{DD}-{SEQ:4}")
  invoicePrefix              String?   @default("INV")
  invoiceFormat              String?   @default("{PREFIX}-{YYYY}{MM}{DD}-{SEQ:4}")
  receiptPrefix              String?   @default("RCP")
  receiptFormat              String?   @default("{PREFIX}-{YYYY}{MM}{DD}-{SEQ:4}")
  creditNotePrefix           String?   @default("CN")
  creditNoteFormat           String?   @default("{PREFIX}-{YYYY}{MM}{DD}-{SEQ:4}")
  poPrefix                   String?   @default("PO")
  poFormat                   String?   @default("{PREFIX}-{YYYY}{MM}{DD}-{SEQ:4}")
  journalPrefix              String?   @default("JNL")
  journalFormat              String?   @default("{PREFIX}-{YYYY}{MM}-{SEQ:4}")
  // Aging buckets (days) — comma-separated
  agingBuckets               String?   @default("0,30,60,90")
  // Visit
  consultationFee            Float     @default(50000)
  followUpWindowDays         Int       @default(14)
  emergencyFee               Float? // overrides consultationFee for EMERGENCY
  scheduledFee               Float? // overrides consultationFee for SCHEDULED
  // Appointment
  defaultAppointmentDuration Int       @default(30) // minutes
  appointmentBufferMinutes   Int       @default(0)
  workingHoursStart          String?   @default("08:00")
  workingHoursEnd            String?   @default("17:00")
  // Pharmacy
  defaultReorderLevel        Int       @default(10)
  defaultMaxStock            Int       @default(100)
  expiryWarningDays          Int       @default(90)
  expiryCriticalDays         Int       @default(30)
  drugMarkupPercent          Float?    @default(0)
  // Finance aging write-off
  autoWriteoffThreshold      Float?    @default(5000)
  // Audit
  auditRetentionDays         Int       @default(2555) // 7 years
  // System limits
  backdateLimitDays          Int       @default(0) // 0 = no limit
  defaultPageSize            Int       @default(50)
  // Status
  isActive                   Boolean   @default(true)
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt

  branches Branch[]
  settings TenantSetting[]
  users    User[]
  consultationFeeCategories ConsultationFeeCategory[]
}

model Branch {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  code      String // short code, e.g. "MAIN", "ANNEX"
  address   String?
  phone     String?
  isMain    Boolean  @default(false)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, code])
}

enum SettingValueType {
  STRING
  NUMBER
  BOOLEAN
  JSON
  ENUM
}

enum SettingCategory {
  CLINIC // identity, branding
  LOCALE // timezone, formats, language
  MONEY // currency, decimals
  NUMBERING // patient, visit, invoice prefixes
  VISIT // fees, follow-up window
  APPOINTMENT // duration, working hours
  PHARMACY // stock thresholds, expiry, markup
  LAB // templates, TAT
  RADIOLOGY // templates, image retention
  BILLING // aging buckets, COGS
  FINANCE // fiscal year, default tax
  COMMUNICATION // SMS provider, sender ID
  SECURITY // password, session, lockout
  LIMITS // backdate, page size
  INTEGRATION // nextcloud, etc.
  ADVANCED // escape hatch
}

model TenantSetting {
  id          String           @id @default(cuid())
  tenantId    String
  key         String
  value       String
  valueType   SettingValueType @default(STRING)
  category    SettingCategory
  description String?
  updatedAt   DateTime         @updatedAt
  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, key])
  @@index([category])
}

model SystemSetting {
  id        String   @id @default(cuid())
