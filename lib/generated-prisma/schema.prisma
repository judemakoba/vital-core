// VisitType — used to decide whether the auto-consultation-fee is charged
// at check-in. Billable types (OPD, EMERGENCY, SCHEDULED) get the fee;
// non-billable types (FOLLOW_UP, LAB_REVIEW, VACCINATION, ANTENATAL) skip it.
// Direct-service types (LAB_ONLY, RADIOLOGY_ONLY, PRESCRIPTION_ONLY) skip both
// triage and consultation entirely — patient is here for one specific service
// per the consolidated visit cycle spec (R45).
enum VisitType {
  OPD // General outpatient visit (billable)
  EMERGENCY // Emergency walk-in (billable)
  SCHEDULED // Booked appointment (billable)
  FOLLOW_UP // Post-treatment / chronic check-in (no consult fee)
  LAB_REVIEW // Just discussing lab/radiology results (no consult fee)
  VACCINATION // Immunization / shot only (no consult fee)
  ANTENATAL // Antenatal check-in (no consult fee; usually bundled)
  OTHER // Anything else

  // Direct-service path — patient is here for one specific service.
  // No triage, no consultation. Visit enters DirectServicePending and
  // the service is dispatched directly to the appropriate department.
  LAB_ONLY // Visit is for a lab test only
  RADIOLOGY_ONLY // Visit is for an imaging exam only
  PRESCRIPTION_ONLY // Visit is to pick up a prescription only

  // Inpatient — visit is/will be admitted to a ward.
  // R62: most OPD visits stay OPD until a doctor submits an
  // IpdRequest and admin/reception fulfils it. Direct-referral /
  // planned admissions create the visit with this type from the start.
  INPATIENT
}

