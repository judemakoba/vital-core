# ─── npm configuration for Vital Core HMS ──────────────────────────────
# Tells npm to accept peer-dependency mismatches. Required because
# next-auth@4.24.11 declares nodemailer@^6.6.5 as a peerOptional, but
# this project uses nodemailer@9.x for the email-client module. next-auth
# only USES nodemailer if you wire up its email features, so the version
# mismatch is harmless — just noisy under strict npm ci.
#
# See: https://docs.npmjs.com/cli/v10/configuring-npm/package-json#legacy-peer-deps
legacy-peer-deps=true

# Fail on install scripts we didn't write (defense in depth)
ignore-scripts=false
