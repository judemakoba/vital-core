# ─── Node / build artifacts ─────────────────────────────────────────────────
node_modules
.next
.next/**
out
build
dist
coverage
.pnp
.pnp.js
.yarn
*.tsbuildinfo
next-env.d.ts

# ─── Prisma generated client (regenerated in Docker) ────────────────────────
# The pre-built client is for Windows. The Dockerfile re-runs
# `prisma generate` so the runtime binary matches Linux x64.
lib/generated-prisma/runtime
lib/generated-prisma/*.d.ts
lib/generated-prisma/*.js
lib/generated-prisma/*.wasm
lib/generated-prisma/package.json
# Keep ONLY: schema.prisma (source for regeneration)

# ─── Test / scratch / debugging files ───────────────────────────────────────
scratch
tests
*.test.ts
*.test.tsx
*.spec.ts
*.spec.tsx
__tests__
.vscode
.idea

# ─── Local env & secrets ────────────────────────────────────────────────────
.env
.env.local
.env.*.local
.env.production
# Keep .env.example so the image still has the template
!/.env.example

# ─── Git / OS files ─────────────────────────────────────────────────────────
.git
.gitignore
.gitattributes
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# ─── Docker & compose (avoid self-referencing) ──────────────────────────────
Dockerfile
.dockerignore
docker-compose.yml
docker-compose.*.yml
deploy
caddy/Caddyfile*

# ─── Logs ───────────────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
logs

# ─── Editor / OS caches ─────────────────────────────────────────────────────
.eslintcache
.parcel-cache
.cache
.turbo

# ─── User uploads & local data (mounted as volumes in prod) ─────────────────
uploads
public/uploads
data
backups
