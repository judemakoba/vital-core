DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/DBNAME?schema=public&connection_limit=10&pool_timeout=15"
NEXTAUTH_SECRET="CHANGE_ME_TO_RANDOM_32_CHARS"
NEXTAUTH_URL="http://localhost:3000"

# Nextcloud (used by Radiology image uploads)
# Get these from: Nextcloud → Settings → Personal → Security → "App passwords"
NEXTCLOUD_URL="https://cloud.example.com"
NEXTCLOUD_USERNAME="vitalcore"
NEXTCLOUD_PASSWORD="CHANGE_ME_TO_APP_PASSWORD"
NEXTCLOUD_BASE_FOLDER="VitalCore/Radiology"
# Set to "false" to skip creating public share links (file would only be viewable by Nextcloud users)
NEXTCLOUD_PUBLIC_SHARE="true"
