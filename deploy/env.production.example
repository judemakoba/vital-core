# ─── Vital Core HMS — production environment template ─────────────────────
# Copy to .env.production at the project root on the LXC, then fill in:
#   cp deploy/env.production.example .env.production
#   $EDITOR .env.production
#   chmod 600 .env.production          # protect the secrets
#
# docker-compose reads from this file (--env-file .env.production).
# NEVER commit the real .env.production to git. The .gitignore already
# excludes it; this template is safe to commit.

# ════════════════════════════════════════════════════════════════════════════
# Postgres (the database the app will talk to)
# ════════════════════════════════════════════════════════════════════════════

# The role the app logs in as. Must exist — Postgres creates it on first
# start from POSTGRES_USER. Pick something other than "postgres" for prod.
POSTGRES_USER=vitalcore

# Password for POSTGRES_USER. Make this long, random, and unique to this
# install. This is the most important secret in the whole stack — if it
# leaks, an attacker can read every patient record.
# Generate one with:  openssl rand -base64 32
POSTGRES_PASSWORD=CHANGE_ME_TO_64_RANDOM_CHARS

# Database name. The Postgres role owns this database by default.
POSTGRES_DB=vitalcore

# ════════════════════════════════════════════════════════════════════════════
# NextAuth (session security)
# ════════════════════════════════════════════════════════════════════════════

# The public URL where users reach the app. NO trailing slash.
#   - Tailscale:    https://vitalcore
#                    (Tailscale MagicDNS resolves "vitalcore" automatically)
#   - Custom domain: https://hms.example.com
#   - LAN access:    https://192.168.1.50  (cert warning, see DEPLOY.md)
# This must EXACTLY match the URL the user's browser shows, or NextAuth
# will refuse to set cookies.
NEXTAUTH_URL=https://CHANGE_ME_TO_TAILSCALE_HOSTNAME

# Random 32+ char string used to sign session JWTs. If you change this
# after launch, every user gets logged out (cookies become invalid).
# Generate with:  openssl rand -base64 32
NEXTAUTH_SECRET=CHANGE_ME_TO_32_RANDOM_CHARS

# ════════════════════════════════════════════════════════════════════════════
# Tailscale (the sidecar that joins your tailnet and issues certs)
# ════════════════════════════════════════════════════════════════════════════

# Tailscale auth key. Get one from:
#   https://login.tailscale.com/admin/settings/keys
#
# Click "Generate auth key" with these settings:
#   - Reusable:        YES  (so container restarts don't fail)
#   - Ephemeral:       NO   (you want the node to persist across restarts)
#   - Tags:            tag:container  (optional, lets you set ACLs in Tailscale)
#   - Expiry:          90 days (rotate before then)
#
# The key looks like:  tskey-auth-k1234567890abcdef...
TS_AUTHKEY=tskey-auth-CHANGE_ME

# Hostname for this node on the tailnet. Users will reach the app at
# https://<TS_HOSTNAME> (bare) or https://<TS_HOSTNAME>.<tailnet>.ts.net.
# Tailscale's MagicDNS auto-resolves the bare name on every device that
# has Tailscale installed. Default: vitalcore.
TS_HOSTNAME=vitalcore

# ════════════════════════════════════════════════════════════════════════════
# Nextcloud (used by Radiology image uploads — optional)
# ════════════════════════════════════════════════════════════════════════════
# If your hospital uses Nextcloud for DICOM/image storage, fill these in.
# Otherwise leave empty and the Radiology module will gracefully disable.
NEXTCLOUD_URL=
NEXTCLOUD_USERNAME=
NEXTCLOUD_PASSWORD=
NEXTCLOUD_BASE_FOLDER=VitalCore/Radiology
NEXTCLOUD_PUBLIC_SHARE=true

# ════════════════════════════════════════════════════════════════════════════
# Outbound email (SMTP — used for invites, password resets, notifications)
# ════════════════════════════════════════════════════════════════════════════
# Without these, the app still runs but no emails are sent. Most hospitals
# point this at their own mail server (e.g. smtp.geminimedical.ug:587).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Vital Core HMS <noreply@geminimedical.ug>"

# ════════════════════════════════════════════════════════════════════════════
# Localisation
# ════════════════════════════════════════════════════════════════════════════

# IANA timezone. Affects date display, business-day calculations, cron jobs.
# See: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TZ=Africa/Kampala
