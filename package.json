{
    "name": "vital-core",
    "version": "0.0.1",
    "description": "Vital Core Hospital Management System",
    "main": "index.js",
    "type": "module",
    "scripts": {
        "dev": "next dev",
        "build": "next build",
        "start": "next start",
        "test:billing": "npx ts-node tests/logic_billing.ts",
        "test:security": "npx ts-node tests/security_probe.ts",
        "test:denial": "echo 'deprecated — denial management moved to ClaimAdjudicationService'",
        "test:validation": "npx ts-node lib/finance/validation-services.test.ts",
        "test": "vitest run",
        "db:seed": "node prisma/seed.cjs",
        "db:seed:finance": "npx ts-node prisma/seed-finance.ts",
        "db:seed:pharmacy": "node prisma/seed-pharmacy.cjs",
        "db:seed:drugs": "node prisma/seed-drugs.cjs",
        "db:seed:icd": "npx ts-node prisma/seed-icd11.ts",
        "db:seed:lab": "node prisma/seed-lab-comprehensive.cjs",
        "db:seed:ipd": "npx ts-node prisma/seed-ipd.ts",
        "db:seed:radiology": "node prisma/seed-radiology.cjs",
        "db:seed:inventory": "npx ts-node prisma/seed-inventory.js",
        "docker:build": "docker compose --env-file .env.production build",
        "docker:up": "docker compose --env-file .env.production up -d",
        "docker:down": "docker compose --env-file .env.production down",
        "docker:logs": "docker compose --env-file .env.production logs -f",
        "docker:logs:tailscale": "docker compose --env-file .env.production logs -f tailscale",
        "docker:logs:app": "docker compose --env-file .env.production logs -f app",
        "docker:ps": "docker compose --env-file .env.production ps",
        "docker:shell": "docker compose --env-file .env.production exec app sh",
        "docker:db": "docker compose --env-file .env.production exec postgres psql -U vitalcore -d vitalcore",
        "docker:seed": "docker compose --env-file .env.production exec app npm run db:seed"
    },
    "prisma": {
        "seed": "node prisma/seed.cjs"
    },
    "devDependencies": {
        "@types/node": "^26.1.2",
        "@types/react": "^18.3.31",
        "lucide-react": "^1.27.0",
        "prisma": "^5.22.0",
        "ts-node": "^10.9.1",
        "typescript": "^4.9.5",
        "vitest": "^0.30.1",
        "ws": "^8.21.1"
    },
    "dependencies": {
        "@hookform/resolvers": "^3.10.0",
        "@prisma/client": "^5.22.0",
        "bcrypt": "^5.1.1",
        "bcryptjs": "^2.4.3",
        "exceljs": "^4.4.0",
        "imapflow": "^1.6.5",
        "mailparser": "^3.9.14",
        "next": "^14.2.35",
        "next-auth": "^4.24.11",
        "nodemailer": "^9.0.3",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "react-hook-form": "^7.83.0",
        "react-is": "^18.3.1",
        "recharts": "^3.10.1",
        "server-only": "^0.0.1",
        "zod": "^3.25.76"
    }
}
