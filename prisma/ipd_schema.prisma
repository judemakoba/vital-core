// ==========================================
// INPATIENT DEPARTMENT (IPD) MODULE
// ==========================================

model Ward {
  id               String    @id @default(cuid())
  name             String
  description      String?
  type             String
  capacity         Int
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  
  beds             Bed[]
  admissions       Admission[]
  wardRates        WardBillableRate[]
  floorStocks      FloorStock[]
}

model Bed {
  id               String    @id @default(cuid())
  wardId           String
  ward             Ward      @relation(fields: [wardId], references: [id])
  bedNumber        String    @unique
  type             String
  features         String?
  status           String    @default("AVAILABLE") // AVAILABLE, OCCUPIED, MAINTENANCE, CLEANING
  ratePerDay       Float?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  
  admissions       Admission[]
}

model Admission {
  id               String    @id @default(cuid())
  admissionNumber  String    @unique
  patientId        String
  patient          Patient   @relation(fields: [patientId], references: [id])
  visitId          String?   @unique
  visit            Visit?    @relation(fields: [visitId], references: [id])
  
  wardId           String?
  ward             Ward?     @relation(fields: [wardId], references: [id])
  bedId            String?
  bed              Bed?      @relation(fields: [bedId], references: [id])
  
  admittingDoctorId String
  admittingDoctor   User     @relation("AdmittingDoctor", fields: [admittingDoctorId], references: [id])
  
  admissionDate    DateTime  @default(now())
  dischargeDate    DateTime?
  status           String    @default("ADMITTED") // ADMITTED, DISCHARGED, TRANSFERRED
  type             String    // EMERGENCY, ELECTIVE, URGENT, TRANSFER
  
  // IPD Billing specific relations
  charges          InpatientCharge[]
  dailySummaries   DailyChargeSummary[]
  deposits         InpatientDeposit[]
  floorStockUsages FloorStockUsage[]
  
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

enum NursingCareLevel {
  STANDARD        // Regular ward nursing
  INTERMEDIATE    // HDU level
  INTENSIVE       // ICU level - 1:1 or 1:2 nursing
  SPECIAL         // Specialized nursing (ventilated, isolation)
  ONE_TO_ONE      // Continuous 1:1 nursing care
}

enum BillableItemCategory {
  ROOM_BOARD
  NURSING_FEE
  MEDICAL_FEE
  PROCEDURE
  MEDICATION
  CONSUMABLE
  LABORATORY
  RADIOLOGY
  THERAPY
  SUNDRY
  DEPOSIT
  OTHER
}

enum ChargeFrequency {
  ONE_TIME        // Charged once per admission
  DAILY           // Charged each day
  PER_SHIFT       // Charged per nursing shift
  PER_SERVICE     // Charged per occurrence
  PER_UNIT        // Charged per unit (e.g., per tablet)
  HOURLY          // For critical care
}

enum ChargeApplication {
  AUTO            // Automatically applied based on rules
  MANUAL          // Must be manually added
  ORDER_BASED     // Generated from doctor orders
  TASK_BASED      // Generated from completed nursing tasks
}

enum PaymentMethod {
  CASH
  MOBILE_MONEY
  CARD
  BANK_TRANSFER
  PAYMENT_PLAN
}

// Standard billable items master list
model BillableItem {
  id               String    @id @default(cuid())
  itemCode         String    @unique // e.g., "NURSE-STD", "SUNDRY-DAILY"
  itemName         String
  description      String?
  
  category         BillableItemCategory
  subCategory      String?   // More specific grouping
  
  // Charge configuration
  frequency        ChargeFrequency
  application      ChargeApplication
  defaultQuantity  Float     @default(1)
  unitOfMeasure    String?   // "day", "shift", "each", "ml"
  
  // Default pricing
  standardRate     Float     // Cash price
  insuranceRate    Float?    // Default insurance rate
  memberRate       Float?    // Member discount rate
  staffRate        Float?    // Staff price
  
  // Tax
  taxRateId        String?
  taxRate          TaxRate?  @relation(fields: [taxRateId], references: [id])
  isTaxable        Boolean   @default(true)
  
  // Revenue account mapping
  revenueAccountId String?
  revenueAccount   ChartOfAccount? @relation(fields: [revenueAccountId], references: [id])
  
  // Rules for automatic application
  autoApplyRules   Json?     // JSON with conditions for auto-application
  
  isActive         Boolean   @default(true)
  requiresAuth     Boolean   @default(false) // Requires doctor order
  requiresApproval Boolean   @default(false) // Requires manager approval
  
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  
  // Relations
  wardRates        WardBillableRate[]
  insuranceRates   InsuranceBillableRate[]
  charges          InpatientCharge[]
}

// Ward-specific rates for billable items
model WardBillableRate {
  id               String    @id @default(cuid())
  wardId           String
  ward             Ward      @relation(fields: [wardId], references: [id])
  
  billableItemId   String
  billableItem     BillableItem @relation(fields: [billableItemId], references: [id])
  
  rate             Float     // Specific rate for this ward
  effectiveFrom    DateTime
  effectiveTo      DateTime?
  
  isActive         Boolean   @default(true)
  
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  
  @@unique([wardId, billableItemId, effectiveFrom])
}

// Insurance-specific rates for billable items
model InsuranceBillableRate {
  id               String    @id @default(cuid())
  insuranceId      String
  insurance        InsuranceCompany @relation(fields: [insuranceId], references: [id])
  
  billableItemId   String
  billableItem     BillableItem @relation(fields: [billableItemId], references: [id])
  
  packageId        String?
  package          InsurancePackage? @relation(fields: [packageId], references: [id])
  
  rate             Float
  copayPercentage  Float?    @default(0)
  copayFixed       Float?    @default(0)
  
  requiresAuth     Boolean   @default(false)
  
  effectiveFrom    DateTime
  effectiveTo      DateTime?
  
  isActive         Boolean   @default(true)
  
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  
  @@unique([insuranceId, billableItemId, packageId])
}

// Individual charges during admission
model InpatientCharge {
  id               String    @id @default(cuid())
  chargeNumber     String    @unique // CHG-2024-0001
  
  admissionId      String
  admission        Admission @relation(fields: [admissionId], references: [id])
  
  billableItemId   String
  billableItem     BillableItem @relation(fields: [billableItemId], references: [id])
  
  // Charge details
  chargeDate       DateTime
  chargeTime       DateTime? // For time-specific charges
  quantity         Float
  unitPrice        Float
  discountAmount   Float     @default(0)
  taxAmount        Float     @default(0)
  totalAmount      Float
  
  // How this charge was generated
  generationMethod String    // AUTO, MANUAL, ORDER, TASK
  sourceId         String?   // Order ID, Task ID, etc.
  
  // For nursing fees - link to shift/nurse
  shiftDate        DateTime?
  shiftType        String?   // MORNING, EVENING, NIGHT
  nurseId          String?
  nurse            User?     @relation("NurseCharge", fields: [nurseId], references: [id])
  nursingLevel     NursingCareLevel?
  
  // For daily sundries
  sundryType       String?   // LINEN, TOILETRIES, HYGIENE, ETC
  
  // For medications
  dispensingId     String?   // Link to pharmacy dispensing
  
  // Insurance allocation
  insuranceId      String?
  insuranceShare   Float?    // Amount covered by insurance
  patientShare     Float?    // Amount patient pays
  copayAmount      Float?    @default(0)
  
  // Billing status
  isBilled         Boolean   @default(false)
  invoiceId        String?
  invoice          Invoice?  @relation(fields: [invoiceId], references: [id])
  
  notes            String?
  
  createdById      String
  createdBy        User      @relation("ChargeCreator", fields: [createdById], references: [id])
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  
  dailyChargeSummaryId String?
  dailyChargeSummary   DailyChargeSummary? @relation(fields: [dailyChargeSummaryId], references: [id])
  depositApplications  DepositApplication[]
  floorStockUsages     FloorStockUsage[]
}

// Daily charge summary - generated each day for patient
model DailyChargeSummary {
  id               String    @id @default(cuid())
  admissionId      String
  admission        Admission @relation(fields: [admissionId], references: [id])
  
  chargeDate       DateTime  // The date these charges cover
  dayOfStay        Int       // Day 1, Day 2, etc.
  
  // Totals
  roomBoardTotal   Float     @default(0)
  nursingTotal     Float     @default(0)
  medicalTotal     Float     @default(0)
  medicationTotal  Float     @default(0)
  procedureTotal   Float     @default(0)
  labTotal         Float     @default(0)
  radiologyTotal   Float     @default(0)
  sundryTotal      Float     @default(0)
  otherTotal       Float     @default(0)
  
  // Grand totals
  subtotal         Float
  taxTotal         Float     @default(0)
  grandTotal       Float
  
  // Insurance breakdown
  insuranceTotal   Float     @default(0)
  patientTotal     Float     @default(0)
  
  // Status
  isFinalized      Boolean   @default(false)
  finalizedAt      DateTime?
  finalizedById    String?
  finalizedBy      User?     @relation("SummaryFinalizer", fields: [finalizedById], references: [id])
  
  notes            String?
  
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  
  // Relations
  charges          InpatientCharge[] // Link to individual charges for this day
}

// Deposit/Advance payments
model InpatientDeposit {
  id               String    @id @default(cuid())
  depositNumber    String    @unique // DEP-2024-0001
  
  admissionId      String
  admission        Admission @relation(fields: [admissionId], references: [id])
  
  depositDate      DateTime
  amount           Float
  paymentMethod    PaymentMethod
  
  receiptNumber    String?   // Receipt issued
  receivedById     String
  receivedBy       User      @relation("DepositReceiver", fields: [receivedById], references: [id])
  
  notes            String?
  
  // Application to charges
  remainingBalance Float     // Unapplied portion
  isFullyApplied   Boolean   @default(false)
  
  createdAt        DateTime  @default(now())
  
  // Relations
  applications     DepositApplication[]
}

model DepositApplication {
  id               String    @id @default(cuid())
  depositId        String
  deposit          InpatientDeposit @relation(fields: [depositId], references: [id])
  
  chargeId         String?
  charge           InpatientCharge? @relation(fields: [chargeId], references: [id])
  
  invoiceId        String?
  invoice          Invoice? @relation(fields: [invoiceId], references: [id])
  
  amountApplied    Float
  appliedAt        DateTime  @default(now())
  appliedById      String
  appliedBy        User      @relation("DepositApplier", fields: [appliedById], references: [id])
}

// Floor stock medications (meds kept on ward for immediate use)
model FloorStock {
  id               String    @id @default(cuid())
  wardId           String
  ward             Ward      @relation(fields: [wardId], references: [id])
  
  drugId           String
  drug             Drug      @relation(fields: [drugId], references: [id])
  
  batchNumber      String?
  quantityOnHand   Int
  reorderLevel     Int
  maxStock         Int
  
  lastCountDate    DateTime?
  lastCountBy      String?
  
  isActive         Boolean   @default(true)
  
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  
  // Relations
  usage            FloorStockUsage[]
}

model FloorStockUsage {
  id               String    @id @default(cuid())
  floorStockId     String
  floorStock       FloorStock @relation(fields: [floorStockId], references: [id])
  
  admissionId      String
  admission        Admission @relation(fields: [admissionId], references: [id])
  
  quantityUsed     Int
  usedAt           DateTime  @default(now())
  usedById         String
  usedBy           User      @relation("FloorStockUser", fields: [usedById], references: [id])
  
  // This generates an inpatient charge
  chargeId         String?
  charge           InpatientCharge? @relation(fields: [chargeId], references: [id])
  
  notes            String?
  
  createdAt        DateTime  @default(now())
}
