# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# ─── Dependencies ──────────────────────────────────────────────────────────
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# ─── Testing ───────────────────────────────────────────────────────────────
/coverage
/test-results
/playwright-report

# ─── Next.js ───────────────────────────────────────────────────────────────
/.next/
/out/
next-env.d.ts
# Backup directories created by `Rename-Item .next -NewName .next.bak`
# during local webpack cache corruption recovery. Never committed.
/.next.bak/
/.next.bak*/
/.next.stale.bak/

# ─── Production builds ────────────────────────────────────────────────────
/build
/dist

# ─── TypeScript ────────────────────────────────────────────────────────────
*.tsbuildinfo

# ─── OS / Editor ──────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.idea
.vscode

# ─── Local env & secrets (NEVER commit these) ────────────────────────────
.env
.env.local
.env.*.local
.env.production
.env.production.local

# ─── Docker (production secrets, never commit) ────────────────────────────
# These are the production env files. The TEMPLATE files (env.production.example)
# ARE tracked — that's how the user knows what to fill in.
!.env.production.example

# ─── Logs & runtime artifacts ─────────────────────────────────────────────
*.log
*.log.*
api-debug.log
prisma-runtime-check.log
build_log*.txt
validate*.txt
query.sql

# ─── Build cache ──────────────────────────────────────────────────────────
.swc/
.tsbuildinfo

# ─── Dev / scratch (ephemeral scripts, debugging artifacts) ───────────────
scratch/
test-*.js
test_*.js
check_*.js
check-*.js
debug-*.js
cleanup-*.ts
cleanup-*.js

# ─── Prisma transient lock files (Windows) ───────────────────────────────
# `prisma generate` writes query_engine-windows.dll.node.tmp<PID> and
# renames it atomically. If the process is killed mid-rename, the
# .tmp file lingers. Safe to delete; harmless to commit but pollutes
# the working tree. Ignore.
lib/generated-prisma/*.tmp*
lib/generated-prisma/*.bak*

# ─── Backup files (keep repo lean) ────────────────────────────────────────
backups/
*.dump
*.dump.gz
*.sql.gz

# ─── Uploaded files (regenerated by app) ──────────────────────────────────
# The app's uploads/ dir is mounted as a volume in production. Locally,
# the .gitkeep marker keeps the dir tracked. Anything in uploads/ is
# generated and shouldn't be committed.
public/uploads/*
!public/uploads/.gitkeep
uploads/*
!uploads/.gitkeep

# ─── Docker compose overrides (local-only) ────────────────────────────────
# docker-compose.yml, Dockerfile, and .dockerignore are tracked as project files.
# Use docker-compose.override.yml for local-only changes.
docker-compose.override.yml

# ─── TLS certs & private keys (NEVER commit) ──────────────────────────────
# The cert files in caddy/ and lan-certs/ are production secrets bound to
# specific LXC hostnames + IPs. A private key checked into git history is
# forever-leaked. Cert regeneration scripts ARE tracked (deploy/*.sh);
# generated cert/key files are not.
caddy/*.pem
caddy/*.crt
caddy/*.key
# lan-certs/ holds private keys (key.pem) and live certs (cert.pem).
# The install scripts and README inside it ARE tracked (see ! below);
# cert/key files are not.
lan-certs/*
!lan-certs/install.sh
!lan-certs/install.ps1
!lan-certs/install.bat
!lan-certs/README.md
*.patch
